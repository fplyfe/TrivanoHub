# ===== GestorShop — variáveis de ambiente =====
# O subir.bat (PC) e o scripts/instalar-vps.sh (VPS) criam o .env com senhas aleatórias. NUNCA commite o .env.
# Só na VPS: domínio usado pelo Caddy para o HTTPS automático
DOMAIN=hub.trivano.com.br
POSTGRES_USER=gestorshop
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=gestorshop
# Em desenvolvimento fora do Docker:
DATABASE_URL=postgresql://gestorshop:troque@localhost:5432/gestorshop?schema=public
AUTH_SECRET=troque-por-um-segredo-aleatorio-com-48-bytes-ou-mais
COOKIE_SECURE=false

# Administrador inicial (criado só no primeiro start, com o banco vazio).
# Os outros usuários são criados por ele na tela Usuários.
USER1_NAME=Administrador
USER1_EMAIL=admin@exemplo.com
USER1_PASSWORD=troque-esta-senha-1
